# ==================================================
# 1. 旧版项目的通用模型配置
# 当前使用 retail-agent + ART 主流程时，这三项可以留空。
# 它们不会自动代替下面的 TEACHER / USER / JUDGE 配置。
# ==================================================

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=


# ==================================================
# 2. 本地学生模型
# 就是我们准备微调、强化学习的 Qwen2.5-3B-Instruct。
#
# 本地模型服务若没有开启密钥认证，可填写 EMPTY。
# EMPTY 是占位字符串，不是云端 API Key。
# 若本地服务开启了认证，需要填写对应密钥。
# ==================================================

LOCAL_LLM_API_KEY=EMPTY


# ==================================================
# 3. Qwen 3.7 Flash 共用配置（使用 retail.qwen37.example.json）
# 可只填下面一个密钥，教师、模拟用户和裁判会共用它。
# 地址来自提供的调用示例；请使用与该服务账号匹配的密钥。
# 如服务商提供了其他地址，在这里替换。
# 各角色单独填写的 TEACHER/USER/JUDGE 配置优先于共用配置。
# ==================================================

DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DASHSCOPE_API_KEY=


# ==================================================
# 4. 教师模型 API
# 用途：让能力较强的模型完成客服任务，生成 SFT 示范。
#
# BASE_URL：模型平台提供的 OpenAI 兼容接口基础地址。
# API_KEY：你在该平台申请的密钥。
# ==================================================

TEACHER_BASE_URL=
TEACHER_API_KEY=


# ==================================================
# 5. 用户模拟器 API
# 用途：扮演客户，提出问题、补充信息、确认修改或退款。
# 采集示范、强化学习和评测时都会用到。
#
# 可以与教师使用同一个平台、同一个模型和同一个密钥。
# 两者通过不同的提示词和独立对话承担不同角色。
# ==================================================

USER_BASE_URL=
USER_API_KEY=


# ==================================================
# 6. 裁判模型 API
# 用途：判断对话是否满足任务中的自然语言要求。
#
# 只有部分官方任务需要调用模型裁判。
# 数据库状态检查由代码完成，不依赖裁判模型。
# 当前运行入口要求提前填写裁判配置。
#
# 起步阶段也可以与教师共用同一个平台和密钥。
# ==================================================

JUDGE_BASE_URL=
JUDGE_API_KEY=


# ==================================================
# 7. 训练日志
# offline：W&B 日志保存在本地，不上传到云端。
# 这不代表整个项目断网，教师等 API 仍会正常联网。
# ==================================================

WANDB_MODE=offline
